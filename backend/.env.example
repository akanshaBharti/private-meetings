# Copy this file to .env and replace the placeholders.
# The Jitsi secret must be configured on the matching Jitsi server as well.

DJANGO_SECRET_KEY=replace_with_a_long_random_django_secret
DEBUG=True
ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Keep sqlite for local development. Use postgresql in production and set DB_*.
DB_ENGINE=sqlite
DB_NAME=private_meetings
DB_USER=private_meetings
DB_PASSWORD=replace_with_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

JITSI_DOMAIN=meet.your-domain.com
JITSI_PROVIDER=self_hosted
JITSI_APP_ID=private_meetings
JITSI_APP_SECRET=replace_with_the_same_secret_used_by_jitsi
JITSI_JWT_SUB=meet.your-domain.com
JITSI_ROOM_PREFIX=private
JITSI_ALLOW_UNSECURED_DEV=False
JITSI_ALLOW_PUBLIC_DEV=False
MEETINGS_VIDEO_ENABLED=True
DRF_ANON_RATE=100/hour
DRF_USER_RATE=1000/hour
DRF_AUTH_RATE=10/minute
